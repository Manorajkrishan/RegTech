# Copy to backend/.env. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
SECRET_KEY=
DB_URL=sqlite+aiosqlite:///./esg_platform.db
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE=8388608
ACCESS_TOKEN_MINUTES=60
# Optional: reviewed, curated year-specific factor JSON; DO NOT point to raw importer output.
FACTOR_PATH=
# Frontend: set in frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Email verification is mandatory when ENVIRONMENT=production
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:3000
# SMTP: configure server credentials for verification and password recovery.
# Never commit working secrets; prefer your hosting provider's secrets manager.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# Root-level Docker Compose private pilot only: random hex values, do NOT commit a filled .env
REGTECH_DB_PASSWORD=
REGTECH_SECRET_KEY=

# Hosted Stripe integration (only after test-mode QA and pricing/terms approval)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FREE_ACTIVITY_LIMIT=25

# Live billing is DISABLED by default; staging accepts sk_test_ keys only.
STRIPE_LIVE_BILLING_ENABLED=false
STRIPE_EXPECTED_CURRENCY=gbp
